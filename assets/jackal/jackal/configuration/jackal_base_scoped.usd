#usda 1.0
(
    defaultPrim = "jackal"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "jackal"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Scope "Looks"
    {
        def Material "material_black"
        {
            token outputs:mdl:displacement.connect = </jackal/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:surface.connect = </jackal/Looks/material_black/Shader.outputs:out>
            token outputs:mdl:volume.connect = </jackal/Looks/material_black/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.15, 0.15, 0.15)
                token outputs:out
            }
        }

        def Material "material_dark_grey"
        {
            token outputs:mdl:displacement.connect = </jackal/Looks/material_dark_grey/Shader.outputs:out>
            token outputs:mdl:surface.connect = </jackal/Looks/material_dark_grey/Shader.outputs:out>
            token outputs:mdl:volume.connect = </jackal/Looks/material_dark_grey/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.2, 0.2, 0.2)
                token outputs:out
            }
        }

        def Material "material_light_grey"
        {
            token outputs:mdl:displacement.connect = </jackal/Looks/material_light_grey/Shader.outputs:out>
            token outputs:mdl:surface.connect = </jackal/Looks/material_light_grey/Shader.outputs:out>
            token outputs:mdl:volume.connect = </jackal/Looks/material_light_grey/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.4, 0.4, 0.4)
                token outputs:out
            }
        }

        def Material "material_yellow"
        {
            token outputs:mdl:displacement.connect = </jackal/Looks/material_yellow/Shader.outputs:out>
            token outputs:mdl:surface.connect = </jackal/Looks/material_yellow/Shader.outputs:out>
            token outputs:mdl:volume.connect = </jackal/Looks/material_yellow/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.8, 0.8, 0)
                token outputs:out
            }
        }
    }

