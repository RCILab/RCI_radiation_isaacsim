#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1       # 기본 스케일이 0.01이므로 보정해줘야 함.
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "DemoRig"
    {
    }

    def Xform "DemoSensorAnchor"
    {
        double3 xformOp:translate = (6.5, 0, 1)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cylinder "RadiationSensor"
        {
            double height = 0.7
            float radius = 0.16
            color3f[] primvars:displayColor = [(0.15, 0.95, 0.25)]
        }
    }

    def Cube "DemoRayGuide"
    {
        double size = 1
        double3 xformOp:translate = (1.25, 0, 1)
        float3 xformOp:scale = (10.5, 0.03, 0.03)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(1, 0.85, 0.2)]
    }

    def Cube "radiation_obstacle_demoShield1_concrete"
    {
        double size = 1
        double3 xformOp:translate = (-2.5, 5.5, 1)
        float3 xformOp:scale = (0.5, 2.8, 2.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.65, 0.65, 0.68)]
    }

    def Cube "radiation_obstacle_demoShield2_aluminium"
    {
        double size = 1
        double3 xformOp:translate = (0.5, 5.5, 1)
        float3 xformOp:scale = (0.5, 2.8, 2.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.75, 0.78, 0.82)]
    }

    def Cube "radiation_obstacle_demoShield3_stainlessSteel"
    {
        double size = 1
        double3 xformOp:translate = (3.5, 5.5, 1)
        float3 xformOp:scale = (0.5, 2.8, 2.4)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.55, 0.63, 0.72)]
    }
}
